# =============================================================================
# Enquiry delivery — see lib/mail.ts
# -----------------------------------------------------------------------------
# Copy the block you need into the Vercel project's environment variables.
# NOTHING HERE HAS A VALUE ON PURPOSE. This file is committed; a real password
# in it is a password published on GitHub.
#
# Until one transport is configured, POST /api/enquiry answers 502
# "unconfigured" and every form falls back to the WhatsApp handoff. Nothing is
# lost, but nothing reaches the inbox either.
# =============================================================================

# ---- 1. SMTP via nodemailer (primary, recommended) --------------------------
# Sends as the mailbox itself, so leads land in its own Sent folder, replies
# thread naturally, and no third party ever holds them. Needs no DNS change and
# no API account — just the mailbox credentials.
#
# For a Hostinger-hosted mailbox:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
# Gmail / Google Workspace needs an App Password, not the account password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#
# SMTP_PORT decides encryption on its own: 465 is implicit TLS, 587 is
# STARTTLS. Only set SMTP_SECURE to override that for an unusual server.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true

# Where enquiries are delivered. Defaults to BRAND.email in lib/site.ts
# (info@himalayanfeeds.com); set this only to send them somewhere else.
# ENQUIRY_TO=

# ---- 2. Resend (alternative) ------------------------------------------------
# Sends from our own domain over Resend's API. Needs himalayanfeeds.com
# verified in Resend by DNS record first, and ENQUIRY_FROM on that domain.
# RESEND_API_KEY=
# ENQUIRY_FROM=

# ---- 3. Web3Forms (fallback) ------------------------------------------------
# No DNS and no mailbox password. The key is issued against an address and
# everything is forwarded there, so the key itself fixes the destination and
# ENQUIRY_TO is ignored.
# WEB3FORMS_ACCESS_KEY=
